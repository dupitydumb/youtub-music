{
  "name": "YouTube Music",
  "safe_name": "youtube-music",
  "version": "1.4.0",
  "author": "Audion Community",
  "description": "Full YouTube Music client — browse Home, Hot Tracks, Trending, search artists/albums/playlists, import playlists from URLs, play and save tracks. Uses YouTube Music InnerTube API (WEB_REMIX) + Piped/Invidious/InnerTube stream fallback chain. No API key required.",
  "repo": "https://github.com/dupitydumb/youtub-music",
  "manifest_url": "https://github.com/dupitydumb/youtub-music/blob/main/plugin.json",
  "type": "js",
  "entry": "index.js",
  "permissions": [
    "network:fetch",
    "ui:inject",
    "player:control",
    "player:read",
    "library:read",
    "library:write",
    "storage:local"
  ],
  "cross_plugin_access": [],
  "ui_slots": [
    "playerbar:menu",
    "mobile:home"
  ],
  "icon": "Youtube-Music-Logo.png",
  "icon_url": "https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6a/Youtube_Music_icon.svg/960px-Youtube_Music_icon.svg.png",
  "category": "library",
  "tags": [
    "youtube",
    "youtube-music",
    "streaming",
    "search",
    "music",
    "playlists",
    "albums",
    "artists",
    "trending"
  ],
  "license": "MIT"
}
